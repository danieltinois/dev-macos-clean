{
  "name": "devclean-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DevClean macOS developer storage analyzer",
  "license": "MIT",
  "type": "module",
  "main": "dist/desktop/main.cjs",
  "bin": {
    "devclean": "cli/devclean.ts"
  },
  "engines": {
    "bun": ">=1.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:engine": "bun scripts/engine.ts",
    "start": "bun run build && electron .",
    "scan": "bun cli/devclean.ts scan",
    "test": "bun test",
    "test:apple": "bun scripts/engine.ts && cd apple/DevCleanKit && swift test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "electron": "^42.0.0",
    "typescript": "^5.9.0"
  }
}
