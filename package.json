{
  "name": "devclean-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "DevClean macOS developer storage analyzer",
  "main": "desktop/main.cjs",
  "scripts": {
    "setup": "python3 -m venv .venv && .venv/bin/python -m pip install -q -e \".[dev]\"",
    "start": "electron .",
    "scan": ".venv/bin/python -m devclean scan",
    "test": "node --test desktop/*.test.cjs && .venv/bin/python -m pytest -q"
  },
  "devDependencies": {
    "electron": "^42.0.0"
  }
}
